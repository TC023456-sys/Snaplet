@@ -0,0 +1,35 @@
+// Porting adapters for running unchanged upstream assertion bodies with Swift Testing.
+import Foundation
+import Testing
+
+func XCTFail(_ message: String = "", file: StaticString = #filePath, line: UInt = #line) { Issue.record("\(message) (\(file):\(line))") }
+private func check(_ body: () throws -> Bool, _ message: String, file: StaticString, line: UInt) {
+ do {if try !body(){XCTFail(message,file:file,line:line)}} catch {XCTFail("\(message): \(error)",file:file,line:line)}
+}
+func XCTAssertTrue(_ x:@autoclosure () throws -> Bool,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try x()},message,file:file,line:line)}
+func XCTAssertFalse(_ x:@autoclosure () throws -> Bool,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try !x()},message,file:file,line:line)}
+func XCTAssertEqual<T:Equatable>(_ a:@autoclosure () throws -> T,_ b:@autoclosure () throws -> T,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try a()==b()},message,file:file,line:line)}
+func XCTAssertEqual<T:BinaryFloatingPoint>(_ a:@autoclosure () throws -> T,_ b:@autoclosure () throws -> T,accuracy:T,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try abs(a()-b())<=accuracy},message,file:file,line:line)}
+func XCTAssertNil<T>(_ a:@autoclosure () throws -> T?,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try a()==nil},message,file:file,line:line)}
+func XCTAssertNotNil<T>(_ a:@autoclosure () throws -> T?,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try a() != nil},message,file:file,line:line)}
+func XCTAssertLessThan<T:Comparable>(_ a:@autoclosure () throws -> T,_ b:@autoclosure () throws -> T,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try a()<b()},message,file:file,line:line)}
+func XCTAssertGreaterThan<T:Comparable>(_ a:@autoclosure () throws -> T,_ b:@autoclosure () throws -> T,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try a()>b()},message,file:file,line:line)}
+func XCTAssertGreaterThanOrEqual<T:Comparable>(_ a:@autoclosure () throws -> T,_ b:@autoclosure () throws -> T,_ message:String="",file:StaticString=#filePath,line:UInt=#line){check({try a()>=b()},message,file:file,line:line)}
+func XCTUnwrap<T>(_ a:@autoclosure () throws -> T?,_ message:String="",file:StaticString=#filePath,line:UInt=#line)throws->T{try #require(try a(),"\(message) (\(file):\(line))")}
+struct XCTSkip:Error {let message:String;init(_ message:String){self.message=message}}
+final class XCTestExpectation:@unchecked Sendable {
+ let description:String;var expectedFulfillmentCount=1;var assertForOverFulfill=true;private let lock=NSLock();private var count=0
+ init(_ description:String){self.description=description}
+ func fulfill(){lock.lock();count+=1;let excess=assertForOverFulfill && count>expectedFulfillmentCount;lock.unlock();if excess{XCTFail("Overfulfilled: \(description)")}}
+ var done:Bool{lock.lock();defer{lock.unlock()};return count>=expectedFulfillmentCount}
+}
+@MainActor class XCTestCase {
+ func setUpWithError() throws {}
+ func tearDownWithError() throws {}
+ func expectation(description:String)->XCTestExpectation{XCTestExpectation(description)}
+ func wait(for expectations:[XCTestExpectation],timeout:TimeInterval){
+  let deadline=Date().addingTimeInterval(timeout)
+  while !expectations.allSatisfy({$0.done}) && Date()<deadline {RunLoop.current.run(until:Date().addingTimeInterval(0.005))}
+  for e in expectations where !e.done {XCTFail("Expectation timed out: \(e.description)")}
+ }
+}
