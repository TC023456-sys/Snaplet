+/// A frame-sized scrolling document must not constrain its containing window.
+/// Settings rows retain their readable width while the viewport can be narrow.
+private final class SettingsScrollView: NSScrollView {
+    var minimumDocumentWidth: CGFloat = 690
+    var fillsViewportHeight = true
+    private var sizingDocument = false
+
+    override func mouseDown(with event: NSEvent) {
+        // Controls/scrollbars handle their own events. Unhandled background
+        // presses may move the settings window, just like its title bar.
+        if let window, window.isMovableByWindowBackground {
+            window.performDrag(with: event)
+        } else {
+            super.mouseDown(with: event)
+        }
+    }
+
+    override func tile() {
+        super.tile()
+        sizeDocument()
+    }
+
+    override func layout() {
+        super.layout()
+        sizeDocument()
+    }
+
+    private func sizeDocument() {
+        guard !sizingDocument, let document = documentView else { return }
+        sizingDocument = true
+        defer { sizingDocument = false }
+        let width = max(minimumDocumentWidth, contentSize.width)
+        if document.frame.width != width {
+            document.setFrameSize(NSSize(width: width, height: document.frame.height))
+        }
+        document.layoutSubtreeIfNeeded()
+        let height = fillsViewportHeight ? max(contentSize.height, document.fittingSize.height) : document.fittingSize.height
+        if document.frame.height != height {
+            document.setFrameSize(NSSize(width: width, height: height))
+        }
+    }
+}
